# Copy to .env.local and fill in. Never commit the real .env.local.
# Full walkthrough: docs/JOBBER_SETUP.md

# From developer.getjobber.com — Developer Center → your app → Credentials
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
# Local dev. In Vercel's project settings, set this to
# https://<your-real-domain>/api/jobber/oauth/callback instead.
JOBBER_REDIRECT_URI=http://localhost:3000/api/jobber/oauth/callback

# Vercel dashboard → your project → Storage → Create Database →
# "Upstash for Redis" (free tier). It sets these two automatically.
# If you set up Upstash directly instead, use UPSTASH_REDIS_REST_URL /
# UPSTASH_REDIS_REST_TOKEN — either pair works, see lib/jobber/tokens.ts.
KV_REST_API_URL=
KV_REST_API_TOKEN=
