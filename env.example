# Copy this file to .env.local and fill in the real values.
# .env.local is git-ignored — it never gets committed or pushed.
# See docs/DEPLOY_SETUP.md and docs/JOBBER_SETUP.md for where each value comes from.

# --- Jobber (docs/JOBBER_SETUP.md) ---
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REDIRECT_URI=http://localhost:3000/api/jobber/oauth/callback

# --- Redis / Upstash, for storing the Jobber connection token ---
# Set automatically if you create the store from the Vercel Storage tab and
# run `vercel env pull` — you shouldn't need to type these by hand.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Site ---
# The real production domain once it's live (docs/DEPLOY_SETUP.md).
# Leave this as your Vercel URL until a custom domain is connected.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Instant quote notifications (optional) ---
# When someone accepts an instant satellite quote, the customer and the full
# measurement always go to Jobber and the server log. Set this as well and the
# whole quote is POSTed as JSON the moment it's accepted — point it at a
# Zapier or Make catch-hook wired to your Gmail and you get the lead in your
# inbox with the shapes, the square metres and a link that reopens the exact
# quote on the map. Leave it blank and nothing breaks; you just read the
# bookings in Jobber instead.
QUOTE_NOTIFY_WEBHOOK=

# --- Analytics ---
# Your GA4 measurement ID (looks like G-XXXXXXXXXX). Leave blank and
# analytics stays completely off — nothing loads or tracks until this is set.
NEXT_PUBLIC_GA_ID=

# --- Google Ads conversion tag ---
# Your Ads conversion ID (looks like AW-XXXXXXXXXX). Google Ads > Tools >
# Conversions > Google tag. Separate from NEXT_PUBLIC_GA_ID on purpose so it
# never touches the GA4 tag's settings. Leave blank and it stays off.
NEXT_PUBLIC_ADS_ID=
